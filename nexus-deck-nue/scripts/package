#!/bin/bash
# Builds a release of the app for this machine and packs it:
#
#   scripts/package            -> dist/nx-app-<os>-<arch>.tar.gz
#   scripts/package <triple>   -> the same for another supported Rust target
#
# Linux: a folder holding nx-app and the icon.
# macOS: NX.app, signed with APPLE_CERTIFICATE_P12 when available,
# otherwise ad hoc. The notarized DMG is a separate, non-blocking CI job.
# Windows (Git Bash): a folder holding nx-app.exe and the icon.
# Windows has curl and tar too, so the app updates the same way.
# No core inside: the installer and the app install the core's own release
# (distribution/core-version is the oldest core this app works with).
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
if [[ $os == macos && $arch != aarch64 ]]; then
  echo "package: Intel Macs aren't supported; build from source instead." >&2
  exit 1
fi
target="$os-$arch"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: nx-app $version for $target"
for notice in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# Only release builds update themselves (src/update.rs).
NX_APP_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/nx-app-$target.tar.gz"
if [[ $os == linux || $os == windows ]]; then
  dir="$work/nx-app"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then cp "$bin/nx-app.exe" "$dir/"; else cp "$bin/nx-app" "$dir/"; fi
  cp assets/icons/nx-ui-icon-clean.svg "$dir/nx-app.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  notices_path=nx-app/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" nx-app
else
  app="$work/NX.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/nx-app" "$app/Contents/MacOS/NX"
  cp assets/icons/NX.icns "$app/Contents/Resources/NX.icns"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  notices_path=NX.app/Contents/Resources/THIRD-PARTY-NOTICES
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>NX</string>
    <key>CFBundleIdentifier</key><string>dev.nx.app</string>
    <key>CFBundleName</key><string>NEXUS</string>
    <key>CFBundleDisplayName</key><string>NEXUS Deck</string>
    <key>CFBundleIconFile</key><string>NX</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in NEXUS Deck can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in NEXUS Deck can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in NEXUS Deck can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
  scripts/mac-sign "$app"
  tar -czf "$out" -C "$work" NX.app
fi
tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
echo "package: $out ($(sha256 "$out"))"
