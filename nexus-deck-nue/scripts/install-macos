#!/bin/bash
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

app="$HOME/Applications/NX.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running NEXUS.
cp target/release/nx-app "$app/Contents/MacOS/NX.new"
mv -f "$app/Contents/MacOS/NX.new" "$app/Contents/MacOS/NX"
chmod +x "$app/Contents/MacOS/NX"
cp assets/icons/NX.icns "$app/Contents/Resources/NX.icns"

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>NX</string>
    <key>CFBundleIdentifier</key><string>dev.nx.app</string>
    <key>CFBundleName</key><string>NEXUS</string>
    <key>CFBundleDisplayName</key><string>NEXUS Deck</string>
    <key>CFBundleIconFile</key><string>NX</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in NEXUS Deck can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in NEXUS Deck can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in NEXUS Deck can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; nx must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
ln -sfn "$app/Contents/MacOS/NX" "$HOME/.local/bin/nx-app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen NEXUS Deck to use the new build."
