{
  "name": "nexus",
  "projectType": "application",
  "sourceRoot": "apps/nexus/src",
  "tags": [
    "scope:product",
    "runtime:dom"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-export.mjs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev apps/nexus"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/nexus/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/nexus/vitest.config.ts"
      }
    }
  }
}