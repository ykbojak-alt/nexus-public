      "./src/*.tsx",
      "./src/*/index.tsx"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@nexus/mock-data": "workspace:*",
    "@nexus/ui": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  }
}